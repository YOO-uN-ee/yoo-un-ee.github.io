---
interface Props {
	title: string;
	titleKo: string;
}

const { title, titleKo } = Astro.props;

import '../styles/global.css';
---

<!doctype html>
<html lang="en" data-theme="nord">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Research portfolio of Jiyoon Pyo" data-ko-content="표지윤의 연구 포트폴리오" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/jiyoon.png" />
		<meta name="generator" content={Astro.generator} />
		<title data-ko={titleKo}>{title}</title>
	</head>
	<body class="bg-white dark:bg-gray-950 transition-colors duration-300">
		<slot />
		<script>
			declare global {
				interface Window {
					toggleTheme: () => void;
				}
			}

			// Initialize theme from browser storage so static prerendering never needs request headers.
			const cookieTheme = document.cookie.match(/(?:^|; )theme=(dark|light)(?:;|$)/)?.[1];
			const savedTheme = localStorage.getItem('theme') || cookieTheme;
			if (savedTheme) {
				document.documentElement.classList.toggle('dark', savedTheme === 'dark');
				document.documentElement.setAttribute('data-theme', savedTheme === 'dark' ? 'nord-dark' : 'nord');
			} else {
				document.documentElement.setAttribute(
					'data-theme',
					document.documentElement.classList.contains('dark') ? 'nord-dark' : 'nord',
				);
			}

			window.toggleTheme = () => {
				const isDark = document.documentElement.classList.toggle('dark');
				const theme = isDark ? 'dark' : 'light';
				document.documentElement.setAttribute('data-theme', isDark ? 'nord-dark' : 'nord');
				localStorage.setItem('theme', theme);
				// Also set a cookie so the server knows the theme on next request
				document.cookie = `theme=${theme}; path=/; max-age=31536000`;
			};

		</script>
	</body>
</html>
