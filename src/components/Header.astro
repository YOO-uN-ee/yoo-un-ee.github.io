---
// import LanguageMenu from './LanguageMenu.astro';

const currentPage = Astro.url.pathname;
const isActive = (path: string) => currentPage === path || currentPage === `${path}/`;

const linkClass = (path: string) =>
	`text-sm font-medium transition-colors whitespace-nowrap ${
		isActive(path)
			? 'text-gray-900 dark:text-white'
			: 'text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white'
	}`;

const mobileLinkClass = (path: string) =>
	`block px-3 py-2 rounded-lg transition-colors font-medium text-sm ${
		isActive(path)
			? 'bg-gray-900 dark:bg-white text-white dark:text-gray-900'
			: 'text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-gray-800'
	}`;

---

<nav class="fixed top-0 left-0 right-0 z-50 flex justify-center pt-3 sm:pt-6 px-4">
	<div class="backdrop-blur-md bg-white/80 dark:bg-gray-950/80 border border-gray-200 dark:border-gray-700 rounded-full px-4 sm:px-6 py-2 sm:py-3 flex items-center justify-between sm:justify-center gap-2 sm:gap-6 shadow-sm w-full sm:w-auto">
		<div class="hidden sm:flex items-center gap-4 md:gap-6">
			<a href="/" class={linkClass('/')} data-ko="홈">Home</a>
			<a href="/publications" class={linkClass('/publications')} data-ko="연구 논문">Publications</a>
			<a href="/experience" class={linkClass('/experience')} aria-current={isActive('/experience') ? 'page' : undefined} data-ko="연구 경력">Experience</a>
			<a href="/education" class={linkClass('/education')} data-ko="학력">Education</a>
			<a href="/blogs" class={linkClass('/blogs')} data-ko="블로그">Blogs</a>
			<a href="/contact" class={linkClass('/contact')} data-ko="연락처">Contact</a>

			<div class="w-px h-6 bg-gray-300 dark:bg-gray-600"></div>

			<a
				data-ko="이력서" href="/cv.pdf"
				target="_blank"
				rel="noreferrer"
				class="text-sm font-medium transition-colors whitespace-nowrap text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white"
			>
				CV
			</a>

			<div class="w-px h-6 bg-gray-300 dark:bg-gray-600"></div>
		</div>

		<div class="flex items-center gap-2">
			{/* <LanguageMenu /> */}

			<button onclick="window.toggleTheme()" class="p-1 sm:p-1.5 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors cursor-pointer flex-shrink-0" aria-label="Toggle theme" data-ko-aria-label="테마 전환" title="Toggle theme" data-ko-title="테마 전환">
				<svg class="w-4 h-4 dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 0 1 8.646 3.646 9.003 9.003 0 0 0 12 21a9.003 9.003 0 0 0 8.354-5.646z"/>
				</svg>
				<svg class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364-.707-.707M6.343 6.343l-.707-.707m12.728 0-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0z"/>
				</svg>
			</button>
		</div>

		<button id="mobile-menu-btn" class="sm:hidden p-1.5 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors cursor-pointer" aria-label="Toggle menu" data-ko-aria-label="메뉴 열기 또는 닫기">
			<svg class="w-5 h-5" id="hamburger-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
			</svg>
			<svg class="w-5 h-5 hidden" id="close-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18 18 6M6 6l12 12"/>
			</svg>
		</button>
	</div>

	<div id="mobile-menu" class="hidden absolute top-14 left-4 right-4 backdrop-blur-md bg-white/80 dark:bg-gray-950/80 border border-gray-200 dark:border-gray-700 rounded-2xl px-4 py-3 space-y-2 shadow-lg sm:hidden">
		<a href="/" onclick="window.closeMobileMenu()" class={mobileLinkClass('/')} data-ko="홈">Home</a>
		<a href="/publications" onclick="window.closeMobileMenu()" class={mobileLinkClass('/publications')} data-ko="연구 논문">Publications</a>
		<a href="/experience" onclick="window.closeMobileMenu()" class={mobileLinkClass('/experience')} aria-current={isActive('/experience') ? 'page' : undefined} data-ko="연구 경력">Experience</a>
		<a href="/education" onclick="window.closeMobileMenu()" class={mobileLinkClass('/education')} data-ko="학력">Education</a>
		<a href="/blogs" onclick="window.closeMobileMenu()" class={mobileLinkClass('/blogs')} data-ko="블로그">Blogs</a>
		<a href="/contact" onclick="window.closeMobileMenu()" class={mobileLinkClass('/contact')} data-ko="연락처">Contact</a>
		<a data-ko="이력서" href="/cv.pdf" target="_blank" rel="noreferrer" onclick="window.closeMobileMenu()" class="block px-3 py-2 rounded-lg transition-colors font-medium text-sm text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-gray-800">CV</a>
	</div>
</nav>

<script>
	declare global {
		interface Window {
			toggleMobileMenu: () => void;
			closeMobileMenu: () => void;
		}
	}

	function toggleMobileMenu() {
		const menu = document.getElementById('mobile-menu');
		const hamburgerIcon = document.getElementById('hamburger-icon');
		const closeIcon = document.getElementById('close-icon');

		if (menu && hamburgerIcon && closeIcon) {
			menu.classList.toggle('hidden');
			hamburgerIcon.classList.toggle('hidden');
			closeIcon.classList.toggle('hidden');
		}
	}

	function closeMobileMenu() {
		const menu = document.getElementById('mobile-menu');
		const hamburgerIcon = document.getElementById('hamburger-icon');
		const closeIcon = document.getElementById('close-icon');

		if (menu && hamburgerIcon && closeIcon) {
			menu.classList.add('hidden');
			hamburgerIcon.classList.remove('hidden');
			closeIcon.classList.add('hidden');
		}
	}

	window.toggleMobileMenu = toggleMobileMenu;
	window.closeMobileMenu = closeMobileMenu;

	const mobileMenuBtn = document.getElementById('mobile-menu-btn');
	if (mobileMenuBtn) {
		mobileMenuBtn.addEventListener('click', toggleMobileMenu);
	}

	document.addEventListener('click', (event) => {
		const menu = document.getElementById('mobile-menu');
		const button = document.getElementById('mobile-menu-btn');

		if (menu && button && !menu.classList.contains('hidden')) {
			if (!menu.contains(event.target as Node) && !button.contains(event.target as Node)) {
				closeMobileMenu();
			}
		}
	});
</script>
