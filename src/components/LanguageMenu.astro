---
const choices = [
	{ mode: 'en', label: 'EN', name: 'English' },
	{ mode: 'ko', label: 'KR', name: '한국어' },
	{ mode: 'auto', label: 'Auto', name: '' },
];
---

<details id="language-menu" class="group relative text-sm text-gray-700 dark:text-gray-300">
	<summary aria-label="Select language" title="Select language" class="flex cursor-pointer list-none items-center gap-1 rounded-full bg-gray-100 px-2 py-1 hover:bg-gray-200 dark:bg-gray-800 dark:hover:bg-gray-700 [&::-webkit-details-marker]:hidden">
		<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z"/>
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.6 9h16.8M3.6 15h16.8M12 3c2.2 2.25 3.3 5.25 3.3 9S14.2 18.75 12 21M12 3C9.8 5.25 8.7 8.25 8.7 12s1.1 6.75 3.3 9"/>
		</svg>
		<span id="selected-language" translate="no">Auto</span>
		<svg class="size-3 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 16 16" aria-hidden="true">
			<path d="m4 6 4 4 4-4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
		</svg>
	</summary>
	<div class="absolute start-0 sm:start-auto sm:end-0 top-full mt-2 w-52 rounded-xl border border-gray-200 bg-white p-1 shadow-lg dark:border-gray-700 dark:bg-gray-950">
		{choices.map(({ mode, label, name }) => (
			<button type="button" data-mode={mode} aria-pressed={mode === 'auto'} class="flex w-full cursor-pointer items-center justify-between gap-3 rounded-lg px-3 py-2 text-start hover:bg-gray-100 dark:hover:bg-gray-800 aria-pressed:font-bold aria-pressed:bg-gray-100 dark:aria-pressed:bg-gray-800">
				<span translate="no">{label}</span>
				<span id={mode === 'auto' ? 'auto-language' : undefined} lang={mode === 'auto' ? undefined : mode} translate="no">{name}</span>
			</button>
		))}
		<p id="translation-status" role="status" class="px-3 py-2 text-xs empty:hidden"></p>
	</div>
</details>

<script>
	import { initLanguageMenu } from '../scripts/language';
	initLanguageMenu();
</script>
